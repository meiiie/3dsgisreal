NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_APP_NAME=Loi Vao

# Leave empty to use sample fallback data. Set this after PostGIS is running.
DATABASE_URL=
NEXT_PUBLIC_SCENE_ASSET_BASE_URL=
SCENE_ASSETS_PUBLIC_BASE_URL=http://127.0.0.1:9000/scene-assets

# Scene asset storage
SCENE_ASSETS_BUCKET=scene-assets
RAW_CAPTURE_BUCKET=raw-captures
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=loi_vao
S3_SECRET_ACCESS_KEY=loi_vao_dev_password

# Optional managed-service path, not used by the Docker-first stack by default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
