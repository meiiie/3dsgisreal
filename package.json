{
  "name": "3dgs-real",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "db:migrate": "pnpm --filter @loi-vao/db migrate",
    "db:migrate:status": "pnpm --filter @loi-vao/db migrate:status",
    "dev": "turbo dev",
    "build": "turbo build",
    "assets:upload": "pnpm --filter @loi-vao/3dgs-tools upload:scene-assets",
    "captures:upload": "pnpm --filter @loi-vao/3dgs-tools upload:raw-capture",
    "gpu:preflight": "python tools/3dgs/pre_gpu_check.py",
    "runtime:preflight": "python tools/3dgs/runtime_preflight.py",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  }
}
